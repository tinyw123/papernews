# Copy this file to `.env` and fill in. Docker Compose reads .env
# automatically and never logs its contents.

# LLM backend: "anthropic" (default), "groq", or "ollama"
LLM_BACKEND=anthropic
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral

# Required when LLM_BACKEND=anthropic. Create a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required when LLM_BACKEND=groq. Create a free key at
# https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# Model IDs on Groq get deprecated/replaced periodically — check
# https://console.groq.com/docs/models for the current list if the default
# (openai/gpt-oss-120b) stops working. As of writing, every current free-tier
# chat model (gpt-oss-120b, gpt-oss-20b, qwen3.6-27b, qwen3.8-27b) shares the
# same limits, so switching model here won't buy you more headroom — see the
# batch/worker settings below for that.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides
# PAPERNEWS_WORKERS=1             # set to 1 for Ollama/CPU or Groq (default 8)
# Groq's free tier caps a single request at 8000 tokens total — a batch of 8
# articles blows straight through that in one call. Set this to 1 for Groq;
# Anthropic/Ollama can keep the default of 8.
# PAPERNEWS_BATCH_SIZE=1          # articles per LLM call (default 8)
# The Groq backend also self-paces against an 8000 tokens/minute rolling
# budget (client-side, before sending each request) so back-to-back calls
# don't add up past Groq's limit even when each one individually fits.
# Lower this if you're still seeing 429s; the default already leaves some
# margin below the real 8000 cap for estimate error.
# GROQ_TPM_BUDGET=6500
# OLLAMA_TIMEOUT=1800             # httpx timeout in seconds for Ollama requests (default 1800)

# Scheduling — pick one:
# INGEST_INTERVAL_SECONDS=14400   # every N seconds (default 4h)
# INGEST_SCHEDULE=07:00,18:00     # cron-style fixed times (overrides the interval)
# INGEST_TIMEZONE=Europe/London   # IANA tz, used with INGEST_SCHEDULE (default UTC)

# Post-ingest delivery hook (e.g. push the new PDF to a reMarkable).
# Drop the script in ./data/hooks/ and point this at it:
# POST_INGEST_HOOK=/data/hooks/push-to-remarkable.sh
# POST_INGEST_HOOK_TIMEOUT=300
