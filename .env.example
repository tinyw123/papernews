# Copy this file to `.env` and fill in. Docker Compose reads .env
# automatically and never logs its contents.

# LLM backend: "anthropic" (default), "groq", or "ollama"
LLM_BACKEND=anthropic
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral

# Required when LLM_BACKEND=anthropic. Create a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Required when LLM_BACKEND=groq. Create a free key at
# https://console.groq.com/keys — the free tier is plenty for a daily digest.
# GROQ_API_KEY=gsk_...
# Model IDs on Groq get deprecated/replaced periodically — check
# https://console.groq.com/docs/models for the current list if the default
# (openai/gpt-oss-120b) stops working. qwen/qwen3.6-27b is a lighter,
# faster free-tier alternative with more request headroom.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides
# PAPERNEWS_WORKERS=1             # set to 1 for Ollama/CPU (default 8 for Anthropic/Groq)
# OLLAMA_TIMEOUT=1800             # httpx timeout in seconds for Ollama requests (default 1800)

# Scheduling — pick one:
# INGEST_INTERVAL_SECONDS=14400   # every N seconds (default 4h)
# INGEST_SCHEDULE=07:00,18:00     # cron-style fixed times (overrides the interval)
# INGEST_TIMEZONE=Europe/London   # IANA tz, used with INGEST_SCHEDULE (default UTC)

# Post-ingest delivery hook (e.g. push the new PDF to a reMarkable).
# Drop the script in ./data/hooks/ and point this at it:
# POST_INGEST_HOOK=/data/hooks/push-to-remarkable.sh
# POST_INGEST_HOOK_TIMEOUT=300
